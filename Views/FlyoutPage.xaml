<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayFolder.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TrayFolder.Models"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <!--  One context menu shared by every row; Opening works out which row it's for.  -->
        <MenuFlyout x:Key="ItemMenu" Opening="ItemMenu_Opening">
            <MenuFlyoutItem Click="MenuPreview_Click" Text="Preview">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A1;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="MenuOpen_Click" Text="Open">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="MenuOpenWith_Click" Text="Open with…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7AC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="MenuCopy_Click"
                KeyboardAcceleratorTextOverride="Ctrl+C"
                Text="Copy">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="MenuCopyPath_Click" Text="Copy as path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="MenuShowInExplorer_Click" Text="Show in File Explorer">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEC50;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <DataTemplate x:Key="ListItemTemplate" x:DataType="models:FileItem">
            <Grid
                Padding="0,6"
                Background="Transparent"
                ColumnSpacing="12"
                ContextFlyout="{StaticResource ItemMenu}"
                Opacity="{x:Bind ItemOpacity}"
                ToolTipService.ToolTip="{x:Bind Entry.Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph}"
                    Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                <Image
                    Width="32"
                    Height="32"
                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                    Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        MaxLines="1"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Details}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileItemTemplate" x:DataType="models:FileItem">
            <Grid
                Width="112"
                Height="124"
                Padding="4"
                Background="Transparent"
                ContextFlyout="{StaticResource ItemMenu}"
                Opacity="{x:Bind ItemOpacity}"
                RowSpacing="4"
                ToolTipService.ToolTip="{x:Bind Entry.Name}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph}"
                    Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    MaxLines="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!--  {Binding}, not x:Bind: the 2.x XAML compiler crashes (WMC9999) on an x:Bind group header.  -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Header}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding CountText}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Invoked="FocusSearch_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Left"
            Invoked="GoUp_Invoked"
            Modifiers="Menu" />
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="12,10,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: which folder, then quick actions  -->
        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton
                x:Name="FolderButton"
                MaxWidth="260"
                Padding="8,4"
                AutomationProperties.Name="Choose folder"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Choose which folder to show">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        x:Name="FolderGlyph"
                        FontSize="16"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        x:Name="FolderTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Downloads"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="FolderMenu" Opening="FolderMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Open in File Explorer"
                Click="OpenInExplorer_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Open in File Explorer">
                <FontIcon FontSize="14" Glyph="&#xE838;" />
            </Button>
            <ToggleButton
                x:Name="PinButton"
                Grid.Column="2"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Keep open"
                Background="Transparent"
                BorderThickness="0"
                Checked="PinButton_Changed"
                ToolTipService.ToolTip="Keep open while dragging several files"
                Unchecked="PinButton_Changed">
                <FontIcon FontSize="14" Glyph="&#xE718;" />
            </ToggleButton>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Search and Explorer-style view options  -->
        <Grid Grid.Row="1" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Margin="0,0,4,0"
                AutomationProperties.Name="Search this folder"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="Search"
                TextChanged="SearchBox_TextChanged" />
            <Button
                x:Name="SortButton"
                Grid.Column="1"
                AutomationProperties.Name="Sort and group"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Sort and group">
                <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" />
                </Button.Flyout>
            </Button>
            <Button
                x:Name="FilterButton"
                Grid.Column="2"
                AutomationProperties.Name="Filter"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Filter">
                <Grid>
                    <FontIcon
                        x:Name="FilterGlyph"
                        FontSize="14"
                        Glyph="&#xE71C;" />
                    <!--  Filled and accented while a filter hides files  -->
                    <FontIcon
                        x:Name="FilterOnGlyph"
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE16E;"
                        Visibility="Collapsed" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="FilterMenu" Opening="FilterMenu_Opening" />
                </Button.Flyout>
            </Button>
            <Button
                x:Name="ViewButton"
                Grid.Column="3"
                AutomationProperties.Name="View"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="View">
                <FontIcon
                    x:Name="ViewGlyph"
                    FontSize="14"
                    Glyph="&#xE8FD;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="ViewMenu" Opening="ViewMenu_Opening" />
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Where we are, once the user opens a subfolder  -->
        <BreadcrumbBar
            x:Name="Breadcrumb"
            Grid.Row="2"
            ItemClicked="Breadcrumb_ItemClicked"
            Visibility="Collapsed" />

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Click="ChooseFolder_Click" Content="Choose folder" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Drag any row out; click to preview. Both views share one grouped source.  -->
        <ListView
            x:Name="FileList"
            Grid.Row="4"
            Margin="-12,0"
            AllowDrop="False"
            CanDragItems="True"
            ContainerContentChanging="Items_ContainerContentChanging"
            DragItemsCompleted="Items_DragItemsCompleted"
            DragItemsStarting="Items_DragItemsStarting"
            ItemTemplate="{StaticResource ListItemTemplate}"
            KeyDown="Items_KeyDown"
            SelectionChanged="Items_SelectionChanged"
            SelectionMode="Extended">
            <ListView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HidesIfEmpty="True" />
            </ListView.GroupStyle>
        </ListView>

        <GridView
            x:Name="FileGrid"
            Grid.Row="4"
            Margin="-4,0,-12,0"
            AllowDrop="False"
            CanDragItems="True"
            ContainerContentChanging="Items_ContainerContentChanging"
            DragItemsCompleted="Items_DragItemsCompleted"
            DragItemsStarting="Items_DragItemsStarting"
            ItemTemplate="{StaticResource TileItemTemplate}"
            KeyDown="Items_KeyDown"
            SelectionChanged="Items_SelectionChanged"
            SelectionMode="Extended"
            Visibility="Collapsed">
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HidesIfEmpty="True" />
            </GridView.GroupStyle>
        </GridView>

        <!--  Empty folder or nothing matching  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Text="This folder is empty."
                TextWrapping="Wrap" />
            <Button
                x:Name="ClearFiltersButton"
                HorizontalAlignment="Center"
                Click="ClearFilters_Click"
                Content="Clear search and filters"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  Footer  -->
        <Grid Grid.Row="5">
            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
