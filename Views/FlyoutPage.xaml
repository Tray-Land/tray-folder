<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayFolder.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TrayFolder.Core"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:viewmodels="using:TrayFolder.ViewModels"
    xmlns:views="using:TrayFolder.Views"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <DataTemplate x:Key="ListItemTemplate" x:DataType="viewmodels:FileItemViewModel">
            <!--  Swipe a row left (touch or pen) to delete it; mouse and keyboard use Delete or the menu.  -->
            <SwipeControl>
              <SwipeControl.RightItems>
                <SwipeItems Mode="Execute">
                  <SwipeItem
                      x:Uid="SwipeDelete"
                      Background="{ThemeResource SystemFillColorCriticalBrush}"
                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                      Invoked="DeleteSwipe_Invoked">
                    <SwipeItem.IconSource>
                      <FontIconSource Glyph="&#xE74D;" />
                    </SwipeItem.IconSource>
                  </SwipeItem>
                </SwipeItems>
              </SwipeControl.RightItems>
            <Grid
                Padding="0,6"
                Background="Transparent"
                ColumnSpacing="12"
                ContextRequested="Item_ContextRequested"
                Opacity="{x:Bind ItemOpacity, Mode=OneTime}"
                ToolTipService.ToolTip="{x:Bind Entry.Name, Mode=OneTime, FallbackValue=''}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneTime}"
                    Visibility="{x:Bind views:UiBindings.Hidden(HasThumbnail), Mode=OneWay}" />
                <Image
                    Width="32"
                    Height="32"
                    Source="{x:Bind (media:ImageSource)Thumbnail, Mode=OneWay}"
                    Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        MaxLines="1"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Details, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            </SwipeControl>
        </DataTemplate>

        <DataTemplate x:Key="TileItemTemplate" x:DataType="viewmodels:FileItemViewModel">
            <Grid
                Width="112"
                Height="124"
                Padding="4"
                Background="Transparent"
                ContextRequested="Item_ContextRequested"
                Opacity="{x:Bind ItemOpacity, Mode=OneTime}"
                RowSpacing="4"
                ToolTipService.ToolTip="{x:Bind Entry.Name, Mode=OneTime, FallbackValue=''}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneTime}"
                    Visibility="{x:Bind views:UiBindings.Hidden(HasThumbnail), Mode=OneWay}" />
                <Image Source="{x:Bind (media:ImageSource)Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    MaxLines="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!--  {Binding}, not x:Bind: the 2.x XAML compiler crashes (WMC9999) on an x:Bind group header.  -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Header}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding CountText}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Invoked="FocusSearch_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Left"
            Invoked="GoUp_Invoked"
            Modifiers="Menu" />
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="12,10,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: which folder, then quick actions. Left/Right move between the buttons (XY focus); Up/Down are in code.  -->
        <Grid
            x:Name="HeaderRow"
            ColumnSpacing="2"
            PreviewKeyDown="Toolbar_PreviewKeyDown"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton
                x:Name="FolderButton"
                MaxWidth="260"
                Padding="8,4"
                AutomationProperties.AutomationId="FolderButton"
                AutomationProperties.Name="Choose folder"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="{x:Bind ViewModel.RootPath, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.FolderGlyph, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.FolderTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <!--  MenuFlyout has no ItemsSource, so Opening adds the folders above these.  -->
                    <MenuFlyout
                        x:Name="FolderMenu"
                        Opening="FolderMenu_Opening"
                        Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="ChooseFolder"
                            AutomationProperties.AutomationId="ChooseFolderMenuItem"
                            Command="{x:Bind ViewModel.ChooseFolderCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                x:Name="OpenFolderButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="OpenFolderButton"
                AutomationProperties.Name="Open in File Explorer"
                Command="{x:Bind ViewModel.OpenFolderCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Open in File Explorer">
                <FontIcon FontSize="14" Glyph="&#xE838;" />
            </Button>
            <ToggleButton
                x:Name="PinButton"
                Grid.Column="2"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="PinButton"
                AutomationProperties.Name="Keep open"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{x:Bind ViewModel.IsPinned, Mode=TwoWay}"
                ToolTipService.ToolTip="Keep open while dragging several files">
                <FontIcon FontSize="14" Glyph="&#xE718;" />
            </ToggleButton>
            <Button
                x:Name="SettingsButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="SettingsButton"
                AutomationProperties.Name="Settings"
                Command="{x:Bind ViewModel.SettingsCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Search and Explorer-style view options  -->
        <Grid
            x:Name="SearchRow"
            Grid.Row="1"
            ColumnSpacing="2"
            PreviewKeyDown="Toolbar_PreviewKeyDown"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Margin="0,0,4,0"
                AutomationProperties.AutomationId="SearchBox"
                AutomationProperties.Name="Search this folder"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="Search"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="SortButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="SortButton"
                AutomationProperties.Name="Sort and group"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Sort and group">
                <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem
                            x:Uid="SortName"
                            AutomationProperties.AutomationId="SortByNameItem"
                            Command="{x:Bind ViewModel.SortCommand}"
                            CommandParameter="{x:Bind core:SortField.Name, Mode=OneTime}"
                            GroupName="Sort"
                            IsChecked="{x:Bind views:UiBindings.Is(Options.SortBy, core:SortField.Name), Mode=OneWay}" />
                        <RadioMenuFlyoutItem
                            x:Uid="SortModified"
                            AutomationProperties.AutomationId="SortByDateItem"
                            Command="{x:Bind ViewModel.SortCommand}"
                            CommandParameter="{x:Bind core:SortField.DateModified, Mode=OneTime}"
                            GroupName="Sort"
                            IsChecked="{x:Bind views:UiBindings.Is(Options.SortBy, core:SortField.DateModified), Mode=OneWay}" />
                        <RadioMenuFlyoutItem
                            x:Uid="SortType"
                            AutomationProperties.AutomationId="SortByTypeItem"
                            Command="{x:Bind ViewModel.SortCommand}"
                            CommandParameter="{x:Bind core:SortField.Type, Mode=OneTime}"
                            GroupName="Sort"
                            IsChecked="{x:Bind views:UiBindings.Is(Options.SortBy, core:SortField.Type), Mode=OneWay}" />
                        <RadioMenuFlyoutItem
                            x:Uid="SortSize"
                            AutomationProperties.AutomationId="SortBySizeItem"
                            Command="{x:Bind ViewModel.SortCommand}"
                            CommandParameter="{x:Bind core:SortField.Size, Mode=OneTime}"
                            GroupName="Sort"
                            IsChecked="{x:Bind views:UiBindings.Is(Options.SortBy, core:SortField.Size), Mode=OneWay}" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem
                            x:Uid="Ascending"
                            AutomationProperties.AutomationId="SortAscendingItem"
                            Command="{x:Bind ViewModel.SortAscendingCommand}"
                            GroupName="Direction"
                            IsChecked="{x:Bind views:UiBindings.Not(Options.Descending), Mode=OneWay}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74A;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem
                            x:Uid="Descending"
                            AutomationProperties.AutomationId="SortDescendingItem"
                            Command="{x:Bind ViewModel.SortDescendingCommand}"
                            GroupName="Direction"
                            IsChecked="{x:Bind Options.Descending, Mode=OneWay}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74B;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Uid="GroupBy" AutomationProperties.AutomationId="GroupByItem">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xF168;" />
                            </MenuFlyoutSubItem.Icon>
                            <RadioMenuFlyoutItem
                                x:Uid="SortModified"
                                AutomationProperties.AutomationId="GroupByDateItem"
                                Command="{x:Bind ViewModel.GroupCommand}"
                                CommandParameter="{x:Bind core:GroupField.DateModified, Mode=OneTime}"
                                GroupName="Group"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.GroupBy, core:GroupField.DateModified), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="SortName"
                                AutomationProperties.AutomationId="GroupByNameItem"
                                Command="{x:Bind ViewModel.GroupCommand}"
                                CommandParameter="{x:Bind core:GroupField.Name, Mode=OneTime}"
                                GroupName="Group"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.GroupBy, core:GroupField.Name), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="Kind"
                                AutomationProperties.AutomationId="GroupByKindItem"
                                Command="{x:Bind ViewModel.GroupCommand}"
                                CommandParameter="{x:Bind core:GroupField.Kind, Mode=OneTime}"
                                GroupName="Group"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.GroupBy, core:GroupField.Kind), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="SortSize"
                                AutomationProperties.AutomationId="GroupBySizeItem"
                                Command="{x:Bind ViewModel.GroupCommand}"
                                CommandParameter="{x:Bind core:GroupField.Size, Mode=OneTime}"
                                GroupName="Group"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.GroupBy, core:GroupField.Size), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="NoGrouping"
                                AutomationProperties.AutomationId="GroupByNoneItem"
                                Command="{x:Bind ViewModel.GroupCommand}"
                                CommandParameter="{x:Bind core:GroupField.None, Mode=OneTime}"
                                GroupName="Group"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.GroupBy, core:GroupField.None), Mode=OneWay}" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="FilterButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="FilterButton"
                AutomationProperties.Name="Filter"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.FilterTip, Mode=OneWay}">
                <Grid>
                    <FontIcon
                        FontSize="14"
                        Glyph="&#xE71C;"
                        Visibility="{x:Bind views:UiBindings.Hidden(ViewModel.IsFiltered), Mode=OneWay}" />
                    <!--  Filled and accented while a filter hides files  -->
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE16E;"
                        Visibility="{x:Bind ViewModel.IsFiltered, Mode=OneWay}" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterImagesItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Image, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Image), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Image), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Image), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterVideosItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Video, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Video), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Video), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Video), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterAudioItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Audio, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Audio), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Audio), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Audio), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterDocumentsItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Document, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Document), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Document), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Document), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterArchivesItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Archive, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Archive), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Archive), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Archive), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterProgramsItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Program, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Program), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Program), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Program), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            AutomationProperties.AutomationId="FilterOtherItem"
                            Command="{x:Bind ViewModel.FilterKindCommand}"
                            CommandParameter="{x:Bind core:FileKind.Other, Mode=OneTime}"
                            IsChecked="{x:Bind views:UiBindings.Contains(Options.Kinds, core:FileKind.Other), Mode=OneWay}"
                            Text="{x:Bind core:FileKinds.PluralLabel(core:FileKind.Other), Mode=OneTime}">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind core:FileKinds.Glyph(core:FileKind.Other), Mode=OneTime}" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Uid="SortModified" AutomationProperties.AutomationId="FilterDateItem">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE787;" />
                            </MenuFlyoutSubItem.Icon>
                            <RadioMenuFlyoutItem
                                x:Uid="AnyTime"
                                AutomationProperties.AutomationId="FilterAnyTimeItem"
                                Command="{x:Bind ViewModel.FilterDateCommand}"
                                CommandParameter="{x:Bind core:DateFilter.Any, Mode=OneTime}"
                                GroupName="Date"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.Date, core:DateFilter.Any), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="Today"
                                AutomationProperties.AutomationId="FilterTodayItem"
                                Command="{x:Bind ViewModel.FilterDateCommand}"
                                CommandParameter="{x:Bind core:DateFilter.Today, Mode=OneTime}"
                                GroupName="Date"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.Date, core:DateFilter.Today), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="PastWeek"
                                AutomationProperties.AutomationId="FilterPastWeekItem"
                                Command="{x:Bind ViewModel.FilterDateCommand}"
                                CommandParameter="{x:Bind core:DateFilter.LastWeek, Mode=OneTime}"
                                GroupName="Date"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.Date, core:DateFilter.LastWeek), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="PastMonth"
                                AutomationProperties.AutomationId="FilterPastMonthItem"
                                Command="{x:Bind ViewModel.FilterDateCommand}"
                                CommandParameter="{x:Bind core:DateFilter.LastMonth, Mode=OneTime}"
                                GroupName="Date"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.Date, core:DateFilter.LastMonth), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="PastYear"
                                AutomationProperties.AutomationId="FilterPastYearItem"
                                Command="{x:Bind ViewModel.FilterDateCommand}"
                                CommandParameter="{x:Bind core:DateFilter.LastYear, Mode=OneTime}"
                                GroupName="Date"
                                IsChecked="{x:Bind views:UiBindings.Is(Options.Date, core:DateFilter.LastYear), Mode=OneWay}" />
                        </MenuFlyoutSubItem>
                        <ToggleMenuFlyoutItem
                            x:Uid="ShowFolders"
                            AutomationProperties.AutomationId="ShowFoldersItem"
                            IsChecked="{x:Bind Options.ShowFolders, Mode=TwoWay}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="ClearFilters"
                            AutomationProperties.AutomationId="ClearFiltersItem"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="ViewButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="ViewButton"
                AutomationProperties.Name="View"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="View">
                <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.ViewGlyph, Mode=OneWay}" />
                <Button.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem
                            x:Uid="ListView"
                            AutomationProperties.AutomationId="ListViewItem"
                            Command="{x:Bind ViewModel.SetViewCommand}"
                            CommandParameter="{x:Bind core:ViewMode.List, Mode=OneTime}"
                            GroupName="View"
                            IsChecked="{x:Bind views:UiBindings.Is(Options.View, core:ViewMode.List), Mode=OneWay}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem
                            x:Uid="TilesView"
                            AutomationProperties.AutomationId="TilesViewItem"
                            Command="{x:Bind ViewModel.SetViewCommand}"
                            CommandParameter="{x:Bind core:ViewMode.Tiles, Mode=OneTime}"
                            GroupName="View"
                            IsChecked="{x:Bind views:UiBindings.Is(Options.View, core:ViewMode.Tiles), Mode=OneWay}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xECA5;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Uid="Extensions"
                            AutomationProperties.AutomationId="ShowExtensionsItem"
                            IsChecked="{x:Bind Options.ShowExtensions, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem
                            x:Uid="HiddenItems"
                            AutomationProperties.AutomationId="ShowHiddenItem"
                            IsChecked="{x:Bind Options.ShowHidden, Mode=TwoWay}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Where we are, once the user opens a subfolder  -->
        <BreadcrumbBar
            x:Name="Breadcrumb"
            Grid.Row="2"
            AutomationProperties.AutomationId="Breadcrumb"
            ItemClicked="Breadcrumb_ItemClicked"
            ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasBreadcrumbs, Mode=OneWay}" />

        <InfoBar
            x:Name="StatusBar"
            Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="ChooseFolderStatusButton"
                    Command="{x:Bind ViewModel.ChooseFolderCommand}"
                    Content="Choose folder"
                    Visibility="{x:Bind ViewModel.CanChooseFolder, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Drag any row out; click to preview. Only the visible one holds the items (see ShowItems).  -->
        <ListView
            x:Name="FileList"
            Grid.Row="4"
            Margin="-12,0"
            AllowDrop="False"
            AutomationProperties.AutomationId="FileList"
            AutomationProperties.Name="Files"
            CanDragItems="True"
            ContainerContentChanging="Items_ContainerContentChanging"
            DragItemsCompleted="Items_DragItemsCompleted"
            DragItemsStarting="Items_DragItemsStarting"
            ItemTemplate="{StaticResource ListItemTemplate}"
            KeyDown="Items_KeyDown"
            PreviewKeyDown="Items_PreviewKeyDown"
            SelectionChanged="Items_SelectionChanged"
            SelectionMode="Extended"
            Visibility="{x:Bind views:UiBindings.Hidden(ViewModel.IsTiles), Mode=OneWay}">
            <ListView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HidesIfEmpty="True" />
            </ListView.GroupStyle>
        </ListView>

        <GridView
            x:Name="FileGrid"
            Grid.Row="4"
            Margin="-4,0,-12,0"
            AllowDrop="False"
            AutomationProperties.AutomationId="FileGrid"
            AutomationProperties.Name="Files"
            CanDragItems="True"
            ContainerContentChanging="Items_ContainerContentChanging"
            DragItemsCompleted="Items_DragItemsCompleted"
            DragItemsStarting="Items_DragItemsStarting"
            ItemTemplate="{StaticResource TileItemTemplate}"
            KeyDown="Items_KeyDown"
            PreviewKeyDown="Items_PreviewKeyDown"
            SelectionChanged="Items_SelectionChanged"
            SelectionMode="Extended"
            Visibility="{x:Bind ViewModel.IsTiles, Mode=OneWay}">
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HidesIfEmpty="True" />
            </GridView.GroupStyle>
        </GridView>

        <!--  Empty folder or nothing matching  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                x:Name="ClearFiltersButton"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ClearFiltersButton"
                Command="{x:Bind ViewModel.ClearSearchAndFiltersCommand}"
                Content="Clear search and filters"
                Visibility="{x:Bind ViewModel.CanClearFilters, Mode=OneWay}" />
        </StackPanel>

        <!--  Footer  -->
        <Grid Grid.Row="5">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
            <ProgressRing
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                IsActive="{x:Bind ViewModel.RefreshCommand.IsRunning, Mode=OneWay, FallbackValue=False}" />
        </Grid>

        <!--  Bottom overlay: the Recycle Bin drop target while dragging, otherwise the timed "Undo delete" pill  -->
        <Grid
            Grid.RowSpan="6"
            Margin="0,0,0,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <Border
                x:Name="DeletePill"
                Padding="16,4,4,4"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Visibility="{x:Bind ViewModel.IsDeleteNoticeShown, Mode=OneWay}">
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" />
                    </TransitionCollection>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        MaxWidth="200"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.DeleteNoticeText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Uid="UndoDelete"
                        AutomationProperties.AutomationId="UndoDeleteButton"
                        Command="{x:Bind ViewModel.UndoDeleteCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanUndoDelete, Mode=OneWay}" />
                    <Button
                        x:Uid="DismissNotice"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="DismissDeleteButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.DismissDeleteCommand}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>

            <Border
                x:Name="RecycleBin"
                Padding="20,12"
                AllowDrop="True"
                AutomationProperties.AutomationId="RecycleBinDropTarget"
                AutomationProperties.Name="Drop here to delete"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="24"
                DragEnter="RecycleBin_DragOver"
                DragLeave="RecycleBin_DragLeave"
                DragOver="RecycleBin_DragOver"
                Drop="RecycleBin_Drop"
                Visibility="{x:Bind ViewModel.IsDragging, Mode=OneWay}">
                <Grid>
                    <!--  Lights up while a drag hovers over the bin  -->
                    <Border
                        x:Name="RecycleBinHot"
                        Margin="-20,-12"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="2"
                        CornerRadius="24"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <Border.OpacityTransition>
                            <ScalarTransition />
                        </Border.OpacityTransition>
                    </Border>
                    <StackPanel
                        IsHitTestVisible="False"
                        Orientation="Horizontal"
                        Spacing="10">
                        <FontIcon FontSize="20" Glyph="&#xE74D;" />
                        <TextBlock
                            x:Uid="RecycleBinDrop"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
