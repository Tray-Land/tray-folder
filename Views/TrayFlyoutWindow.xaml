<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayFolder.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Tray Folder">

    <Grid
        x:Name="PopupRoot"
        KeyboardAcceleratorPlacementMode="Hidden"
        PointerPressed="PopupRoot_PointerPressed">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <!--  The list, a file's preview, or settings; swapping slides like a drill-in  -->
        <ContentPresenter x:Name="PageHost">
            <ContentPresenter.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="24" />
                </TransitionCollection>
            </ContentPresenter.ContentTransitions>
        </ContentPresenter>
    </Grid>
</ex:WindowEx>
