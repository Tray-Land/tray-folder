<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayFolder.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TrayFolder.Core"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:playback="using:Windows.Media.Playback"
    xmlns:views="using:TrayFolder.Views"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="Previous_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="Next_Invoked" />
        <KeyboardAccelerator Key="Back" Invoked="Back_Invoked" />
        <KeyboardAccelerator
            Key="Left"
            Invoked="Back_Invoked"
            Modifiers="Menu" />
        <KeyboardAccelerator
            Key="C"
            Invoked="Copy_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="X"
            Invoked="Cut_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="C"
            Invoked="CopyPath_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator Key="Enter" Invoked="Open_Invoked" />
        <KeyboardAccelerator
            Key="Enter"
            Invoked="Open_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="E"
            Invoked="ShowInExplorer_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="O"
            Invoked="OpenWith_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator Key="Application" Invoked="MoreMenu_Invoked" />
        <KeyboardAccelerator
            Key="F10"
            Invoked="MoreMenu_Invoked"
            Modifiers="Shift" />
        <KeyboardAccelerator Key="PageUp" Invoked="PreviousPage_Invoked" />
        <KeyboardAccelerator Key="PageDown" Invoked="NextPage_Invoked" />
        <KeyboardAccelerator Key="Up" Invoked="FocusHeader_Invoked" />
        <KeyboardAccelerator Key="Down" Invoked="FocusActions_Invoked" />
        <KeyboardAccelerator Key="Space" Invoked="PlayPause_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: back, name, previous/next through the folder  -->
        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.AutomationId="DetailBackButton"
                AutomationProperties.Name="Back"
                Command="{x:Bind ViewModel.BackCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Grid
                Grid.Column="1"
                Margin="4,0,0,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Always draggable, even when the preview itself is busy with text or a player  -->
                <Grid
                    x:Name="DragHandle"
                    AutomationProperties.AutomationId="DragHandle"
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Drag to copy this file"
                    Background="Transparent"
                    CanDrag="True"
                    DragStarting="PreviewArea_DragStarting"
                    DropCompleted="PreviewArea_DropCompleted"
                    ToolTipService.ToolTip="Drag to copy this file">
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.Item.Glyph, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind views:UiBindings.Hidden(ViewModel.Item.HasThumbnail), Mode=OneWay}" />
                    <Image Source="{x:Bind (media:ImageSource)ViewModel.Item.Thumbnail, Mode=OneWay, FallbackValue={x:Null}}" Stretch="Uniform" />
                </Grid>
                <TextBlock
                    x:Name="NameText"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Name, Mode=OneWay}"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button
                x:Name="PreviousButton"
                AutomationProperties.AutomationId="PreviousFileButton"
                Grid.Column="2"
                AutomationProperties.Name="Previous file"
                Command="{x:Bind ViewModel.PreviousCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Previous (Left arrow)">
                <FontIcon FontSize="14" Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="NextButton"
                AutomationProperties.AutomationId="NextFileButton"
                Grid.Column="3"
                AutomationProperties.Name="Next file"
                Command="{x:Bind ViewModel.NextCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Next (Right arrow)">
                <FontIcon FontSize="14" Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <!--  The preview; drag it out just like a row in the list  -->
        <Grid
            x:Name="PreviewArea"
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CanDrag="{x:Bind ViewModel.CanDragPreview, Mode=OneWay}"
            CornerRadius="8"
            DragStarting="PreviewArea_DragStarting"
            DropCompleted="PreviewArea_DropCompleted"
            ToolTipService.ToolTip="Drag to copy this file">

            <Image
                Margin="8"
                Source="{x:Bind (media:ImageSource)ViewModel.Preview.Image, Mode=OneWay, FallbackValue={x:Null}}"
                Stretch="Uniform"
                Visibility="{x:Bind ViewModel.Preview.HasImage, Mode=OneWay, FallbackValue=Collapsed}" />

            <ScrollViewer
                Padding="12,8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                Visibility="{x:Bind ViewModel.Preview.HasText, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    x:Name="PreviewText"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Preview.Text, Mode=OneWay, FallbackValue=''}" />
            </ScrollViewer>

            <MediaPlayerElement
                x:Name="PreviewMedia"
                AreTransportControlsEnabled="True"
                AutoPlay="False"
                PosterSource="{x:Bind (media:ImageSource)ViewModel.Item.AudioPoster, Mode=OneWay, FallbackValue={x:Null}}"
                Source="{x:Bind (playback:IMediaPlaybackSource)ViewModel.Preview.Media, Mode=OneWay, FallbackValue={x:Null}}"
                Stretch="Uniform"
                Visibility="{x:Bind ViewModel.Preview.HasMedia, Mode=OneWay, FallbackValue=Collapsed}" />

            <!--  No preview: the shell's large icon or thumbnail  -->
            <StackPanel
                x:Name="NoPreview"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.HasNoPreview, Mode=OneWay}">
                <Grid Width="128" Height="128">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.Item.Glyph, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind views:UiBindings.Hidden(ViewModel.Preview.HasThumbnail), Mode=OneWay}" />
                    <Image Source="{x:Bind (media:ImageSource)ViewModel.Preview.Thumbnail, Mode=OneWay, FallbackValue={x:Null}}" Stretch="Uniform" />
                </Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.PreviewMessage, Mode=OneWay}" />
            </StackPanel>

            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.LoadCommand.IsRunning, Mode=OneWay, FallbackValue=False}" />

            <!--  PDF pages  -->
            <StackPanel
                x:Name="PdfPager"
                Margin="0,0,0,8"
                Padding="4,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="{x:Bind ViewModel.ShowPdfPager, Mode=OneWay}">
                <Button
                    AutomationProperties.Name="Previous page"
                    AutomationProperties.AutomationId="PreviousPdfPageButton"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Style="{StaticResource FlyoutIconButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </Button>
                <TextBlock
                    x:Name="PdfPageText"
                    Text="{x:Bind ViewModel.PageText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <Button
                    AutomationProperties.Name="Next page"
                    AutomationProperties.AutomationId="NextPdfPageButton"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Style="{StaticResource FlyoutIconButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Details  -->
        <ItemsControl
            x:Name="InfoGrid"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Information, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:FileInformation">
                    <Grid Margin="0,2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Label, Mode=OneTime}" />
                        <TextBlock
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Value, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind Value, Mode=OneTime}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <InfoBar
            x:Uid="ActionError"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Warning" />

        <!--  Actions  -->
        <!--  Left/Right move between these buttons (XY focus); elsewhere on the page they step through the files.  -->
        <Grid
            x:Name="ActionRow"
            Grid.Row="4"
            ColumnSpacing="6"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="OpenButton"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="OpenFileButton"
                AutomationProperties.Name="Open"
                Command="{x:Bind ViewModel.OpenCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>
            <Button
                x:Name="CopyButton"
                AutomationProperties.AutomationId="CopyFileButton"
                Grid.Column="1"
                AutomationProperties.Name="Copy"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CopyCommand}"
                ToolTipService.ToolTip="Copy the file, then paste it anywhere (Ctrl+C)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    <TextBlock x:Name="CopyText" Text="{x:Bind ViewModel.CopyText, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="ShowFileButton"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Show in File Explorer"
                Command="{x:Bind ViewModel.ShowInExplorerCommand}"
                ToolTipService.ToolTip="Show in File Explorer">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xEC50;" />
                    <TextBlock Text="Show" />
                </StackPanel>
            </Button>
            <Button
                x:Name="MoreButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="MoreFileActionsButton"
                AutomationProperties.Name="More actions"
                ToolTipService.ToolTip="More">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="CutFileMenuItem"
                            Command="{x:Bind ViewModel.CutCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+X"
                            Text="Cut">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C6;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="OpenWithMenuItem"
                            Command="{x:Bind ViewModel.OpenWithCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+O"
                            Text="Open with…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7AC;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="CopyFilePathMenuItem"
                            Command="{x:Bind ViewModel.CopyPathsCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                            Text="Copy as path">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE62F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Page>
